# Lightweight SQLite database API.
class Database
    def initialize(path)
        self.path = path
    end

    def execute(sql)
        return __sqlite_execute(self.path, sql)
    end

    def query(sql)
        return __sqlite_query(self.path, sql)
    end

    def create_table(name, columns)
        return self.execute("CREATE TABLE " + name + " (" + columns + ")")
    end

    def insert(table, columns, values)
        return self.execute("INSERT INTO " + table + " (" + columns + ") VALUES (" + values + ")")
    end

    def rows(sql)
        return self.query(sql)
    end
end

class SQLite
    def open(path)
        return Database.new(path)
    end
end

sqlite = SQLite.new()

# Flat public SQLite API.
def open(path); return Database.new(path); end
def execute(db, sql); return db.execute(sql); end
def query(db, sql); return db.query(sql); end
def create_table(db, name, columns); return db.create_table(name, columns); end
def insert(db, table, columns, values); return db.insert(table, columns, values); end
def rows(db, sql); return db.rows(sql); end


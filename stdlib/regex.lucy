# Regular expression helpers.
class Regex
    def match(pattern, text)
        return __regex_match(pattern, text)
    end

    def search(pattern, text)
        return __regex_search(pattern, text)
    end

    def find_all(pattern, text)
        return __regex_find_all(pattern, text)
    end

    def replace(pattern, replacement, text)
        return __regex_replace(pattern, replacement, text)
    end

    def contains(pattern, text)
        return self.search(pattern, text)
    end
end

regex = Regex.new()

# String utilities built on Lucy's native string methods.
class StringTools
    def capitalize(text)
        if text.length() == 0
            return text
        end
        return text[0].upper() + text.slice(1)
    end

    def upper(text)
        return text.upper()
    end

    def lower(text)
        return text.lower()
    end

    def trim(text)
        return text.strip()
    end

    def reverse(text)
        return text.reverse()
    end

    def repeat(text, count)
        return text.repeat(count)
    end

    def split(text, separator)
        return text.split(separator)
    end

    def replace(text, old_value, new_value)
        return text.replace(old_value, new_value)
    end

    def contains(text, value)
        return text.contains(value)
    end

    def starts_with(text, value)
        return text.starts_with(value)
    end

    def ends_with(text, value)
        return text.ends_with(value)
    end

    def length(text)
        return text.length()
    end

    def to_int(text)
        return text.to_int()
    end

    def to_float(text)
        return text.to_float()
    end

    def lines(text)
        return text.split("\n")
    end

    def words(text)
        trimmed = text.strip()
        if trimmed == ""
            return []
        end
        return trimmed.split(" ")
    end
end

string = StringTools.new()

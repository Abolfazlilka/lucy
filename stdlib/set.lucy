# Set collection built on arrays with uniqueness guarantees.
class Set
    def initialize(values = [])
        self.values = []
        self.merge(values)
    end

    def new(values = [])
        return Set.new(values)
    end

    def add(value)
        if !self.values.contains(value)
            self.values.push(value)
        end
        return self
    end

    def delete(value)
        index = self.values.index(value)
        if index == nil
            return false
        end
        self.values.remove_at(index)
        return true
    end

    def include?(value)
        return self.values.contains(value)
    end

    def member?(value)
        return self.include?(value)
    end

    def each(callback)
        return self.values.each(callback)
    end

    def size()
        return self.values.length()
    end

    def length()
        return self.size()
    end

    def empty?()
        return self.size() == 0
    end

    def clear()
        self.values = []
        return self
    end

    def map(callback)
        return self.values.map(callback)
    end

    def select(callback)
        return self.values.filter(callback)
    end

    def reject(callback)
        result = []
        for value in self.values
            if !callback(value)
                result.push(value)
            end
        end
        return result
    end

    def merge(other)
        if type(other) == "array"
            for value in other
                self.add(value)
            end
        else
            for value in other.values
                self.add(value)
            end
        end
        return self
    end

    def subset(other)
        for value in self.values
            if !other.include?(value)
                return false
            end
        end
        return true
    end

    def superset(other)
        return other.subset(self)
    end

    def intersect(other)
        result = Set.new()
        for value in self.values
            if other.include?(value)
                result.add(value)
            end
        end
        return result
    end

    def union(other)
        result = Set.new(self.values)
        return result.merge(other.values)
    end

    def intersection(other)
        return self.intersect(other)
    end

    def difference(other)
        result = Set.new()
        for value in self.values
            if !other.include?(value)
                result.add(value)
            end
        end
        return result
    end

    def subset?(other)
        return self.subset(other)
    end

    def superset?(other)
        return self.superset(other)
    end

    def intersect?(other)
        for value in self.values
            if other.include?(value)
                return true
            end
        end
        return false
    end

    def symmetric_difference(other)
        return self.difference(other).merge(other.difference(self))
    end
end

set = Set.new()

# Flat public set API.
def new(values = []); return Set.new(values); end
def from_values(values); return Set.new(values); end
def add(target, value); return target.add(value); end
def delete(target, value); return target.delete(value); end
def include?(target, value); return target.include?(value); end
def union(left, right); return left.union(right); end
def intersection(left, right); return left.intersection(right); end
def difference(left, right); return left.difference(right); end
def symmetric_difference(left, right); return left.symmetric_difference(right); end
def subset?(left, right); return left.subset?(right); end
def superset?(left, right); return left.superset?(right); end
def intersect?(left, right); return left.intersect?(right); end


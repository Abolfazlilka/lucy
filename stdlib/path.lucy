# Cross-platform path manipulation.
class Path
    def join(parts)
        return __path_join(parts)
    end

    def absolute(path)
        return __path_absolute(path)
    end

    def expand(path)
        return __path_expand(path)
    end

    def basename(path)
        return __path_basename(path)
    end

    def dirname(path)
        return __path_dirname(path)
    end

    def extname(path)
        return __path_extname(path)
    end

    def stem(path)
        return __path_stem(path)
    end

    def join_all(first, second)
        parts = [first]
        parts.push(second)
        return self.join(parts)
    end

    def with_extension(path, extension)
        if extension == ""
            return path
        end
        base = self.stem(path)
        directory = self.dirname(path)
        if extension[0] != "."
            extension = "." + extension
        end
        return self.join([directory, base + extension])
    end
end

path = Path.new()

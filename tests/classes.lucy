class Account
    def initialize(balance)
        self.balance = balance
    end
    def deposit(amount)
        self.balance += amount
        return self.balance
    end
end
account = Account.new(100)
assert account.balance == 100
assert account.deposit(25) == 125
assert account.balance == 125
class Savings < Account
    def bonus()
        return self.balance + 10
    end
end
s = Savings.new(50)
assert s.balance == 50
assert s.bonus() == 60
print "classes ok"

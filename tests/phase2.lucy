# Phase 2 standard library integration tests.
import regex
import json
import datetime
import process
import encoding
import csv
import sqlite
import file

assert regex.match("^[a-z]+$", "lucy")
assert regex.search("world", "hello world")
assert regex.find_all("[0-9]+", "a12 b34").length() == 2
assert regex.replace("[0-9]+", "X", "a12 b34") == "aX bX"

payload = json.parse("{\"name\":\"Lucy\",\"items\":[1,2,3],\"active\":true}")
assert payload.name == "Lucy"
assert payload.items.length() == 3
assert payload.active == true
encoded_json = json.stringify(payload)
assert regex.search("Lucy", encoded_json)

now = datetime.now()
parts = now.parts()
assert parts.has("year")
assert now.format("%Y").length() == 4

assert encoding.base64_decode(encoding.base64_encode("Lucy")) == "Lucy"
assert encoding.hex_decode(encoding.hex_encode("Lucy")) == "Lucy"
assert encoding.url_decode(encoding.url_encode("hello world")) == "hello world"

rows = csv.parse("name,age\nNima,21\nLucy,1")
assert rows.length() == 3
assert rows[1][0] == "Nima"
assert csv.stringify(rows) == "name,age\nNima,21\nLucy,1"

db = sqlite.open("phase2-test.sqlite")
db.execute("DROP TABLE IF EXISTS users")
db.execute("CREATE TABLE users (name TEXT, age INTEGER)")
db.execute("INSERT INTO users VALUES ('Nima', 21)")
result = db.query("SELECT name, age FROM users")
assert result.length() == 1
assert result[0].name == "Nima"
assert result[0].age == 21
file.delete("phase2-test.sqlite")

command = process.run("printf phase2")
assert command.success == true
assert command.stdout.strip() == "phase2"

print "phase2 ok"

import os
assert type(os.home()) == "string"
assert type(os.temp_dir()) == "string"
assert os.command_exists("sh") == true or os.command_exists("cmd") == true
